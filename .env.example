# Copy to .env.local (ignored). Fill values; never commit credentials.
PROCVLM_ENV=/absolute/path/to/train-env
PROCVLM_EVAL_ENV=/absolute/path/to/eval-env
EVQA_DATASET_ROOT=/absolute/path/to/procvqa
PROCVLM_MEDIA_INDEX=/absolute/path/to/procvqa/media_index
PROCVLM_BASE_MODEL=/absolute/path/to/Qwen3-VL-2B-Instruct
STAGE1_MODEL=/absolute/path/to/completed-stage1
STAGE2_MODEL=/absolute/path/to/completed-stage2
PROCVLM_RUN_ROOT=/absolute/path/to/NEW-training-run
PROCVLM_LOG_DIR=/absolute/path/to/NEW-evaluation-output
AWS_SHARED_CREDENTIALS_FILE=/absolute/path/to/private/credentials
AWS_CONFIG_FILE=/absolute/path/to/private/config
AWS_PROFILE=your-profile
AWS_DEFAULT_REGION=your-region
AWS_ENDPOINT_URL=https://your-s3-endpoint
PROCVLM_S3_BUCKET=your-bucket
PROCVLM_S3_PREFIX=your-media-prefix
PROCVLM_NNODES=4
PROCVLM_NPROC=4
PROCVLM_GRAD_ACCUM=32
PROCVLM_SAVE_TOTAL_LIMIT=1
# Set separately on every allocated node, not globally for all four nodes:
# PROCVLM_NODE_RANK=0
# PROCVLM_MASTER_ADDR=reachable-master-host
# PROCVLM_MASTER_PORT=29702
